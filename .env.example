# ./.env.example
NODE_ENV=development

API_PORT=3001
WEB_PORT=5173

DATABASE_URL=./data/firewall.db

PAYMENT_PROVIDER=mock

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# deterministic = keyword parser only; external = LLM drafts the mandate, deterministic fallback
LLM_PROVIDER=deterministic
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# If the model above is not available to your key, these are tried in order.
LLM_MODEL=openai/gpt-oss-20b
LLM_MODEL_FALLBACKS=llama-3.1-8b-instant,openai/gpt-oss-120b,llama-3.3-70b-versatile
LLM_TIMEOUT_MS=8000

MCP_PORT=3002